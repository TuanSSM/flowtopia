# Copy to .env and fill in: cp .env.example .env && chmod 600 .env
POSTGRES_PASSWORD=change-me
# The admin account is created on first start only. Changing these later does nothing.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Where port 3169 is published. Unset: this machine only (127.0.0.1), for a reverse proxy on the same
# machine. The machine's LAN address, or 0.0.0.0 for every address, lets other devices open it directly.
#FLOWA_BIND=0.0.0.0
# HTTPS for everyone (README, HTTPS): the name people open, and the profile that starts the reverse
# proxy for it. Ports 80 and 443 of this machine must be reachable under that name.
#FLOWA_DOMAIN=flowa.example.org
#COMPOSE_PROFILES=proxy
