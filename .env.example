# Copy to .env and fill in: cp .env.example .env && chmod 600 .env
POSTGRES_PASSWORD=change-me
# The admin account is created on first start only. Changing these later does nothing.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# For the fit_suggest workflow (README, Next-trick suggestions): a secret of 32 characters or more that
# lets it read the shared transition counts, which name no member. Make one with: openssl rand -hex 32
#FLOWA_COUNTS_TOKEN=
